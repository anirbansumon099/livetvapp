<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LivetvApp - 404 Error: Page Not Found</title>
<script src="https://cdn.jsdelivr.net/npm/clappr@latest/dist/clappr.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<style>
/* Minified CSS with Direct Hex Codes and !important */
body{margin:0;font-family:'Roboto',sans-serif;background:#0A1929!important;color:#E0F7FA!important;min-height:100vh;display:flex;flex-direction:column}nav{display:flex;justify-content:space-between;align-items:center;padding:10px 4%;background:#1A2C40;position:sticky;top:0;z-index:50;box-shadow:0 2px 4px rgba(0,0,0,.6);min-height:64px}.logo{font-size:24px;font-weight:700;color:#E0F7FA!important;text-decoration:none}.logo span{color:#0D47A1;font-weight:500}.nav-links{display:flex;align-items:center;margin-left:50px;flex-grow:1}.nav-link{color:#E0F7FA;text-decoration:none;font-weight:500;padding:10px 15px;border-radius:8px;transition:background .2s}.nav-link:hover{background:rgba(13,71,161,.2)}.search-wrapper{position:relative}.search-wrapper input{background:#000000;border:none;padding:10px 40px 10px 15px;border-radius:24px;color:#E0F7FA;width:250px;transition:.3s;font-family:'Roboto',sans-serif;box-shadow:inset 0 0 0 1px #546E7A}.search-icon{position:absolute;right:10px;top:10px;color:#546E7A}.search-wrapper input:disabled{opacity:.6;cursor:not-allowed}.ad-slot{width:100%;max-width:1000px;margin:16px auto;min-height:80px;background:#0A1929;border:1px dashed #546E7A;display:flex;align-items:center;justify-content:center;color:#546E7A;font-size:14px;border-radius:12px}.container{padding:16px 4%;max-width:1000px;margin:auto;flex-grow:1;display:flex;align-items:center;justify-content:center;text-align:center}.error-card{background:#1A2C40;padding:40px 60px;border-radius:24px;max-width:500px;width:100%;box-shadow:0 4px 12px rgba(0,0,0,.6);border-top:5px solid #B00020}.error-icon{font-size:70px;color:#B00020;margin-bottom:20px}.error-code{font-size:80px;font-weight:700;color:#B00020;line-height:1;margin:0 0 10px 0}.error-title{font-size:28px;font-weight:700;color:#E0F7FA;margin-bottom:15px}.error-message{font-size:16px;color:#546E7A;margin-bottom:30px;line-height:1.5}.home-button{display:inline-flex;align-items:center;padding:12px 25px;background:#0D47A1;color:#E0F7FA;text-decoration:none;border-radius:8px;font-weight:500;transition:background .2s ease,box-shadow .2s ease;box-shadow:0 2px 4px rgba(0,0,0,.4)}.home-button:hover{background:#1976D2;box-shadow:0 4px 8px rgba(0,0,0,.6)}@media (max-width:768px){.nav-links{display:none}.search-wrapper input{width:120px}.error-card{padding:30px 20px}}
</style>
</head>
<body>

<nav>
  <a href="/" class="logo">Livetv<span>App</span></a>
  <div class="nav-links">
    <a href="/" class="nav-link">Home</a>
    <a href="/streams" class="nav-link">Channels</a>
    <a href="/about" class="nav-link">About</a> </div>
  <div class="search-wrapper">
    <input type="text" id="searchInput" placeholder="Find channels..." disabled>
    <i class="fas fa-search search-icon"></i>
  </div>
</nav>

<div class="ad-slot" id="adContainer1">
  Advertisement Slot
</div>

<div class="container">
    <div class="error-card">
        <i class="fas fa-exclamation-triangle error-icon"></i>

        <div class="error-code">404</div>

        <div class="error-title">Page Not Found</div>

        <p class="error-message">
            Sorry! The address you were looking for might be incorrect or has been deleted. Please ensure the URL is correct.
        </p>
        
        <a href="/" class="home-button">
            <i class="fas fa-home" style="margin-right: 8px;"></i>
            Go back to Homepage
        </a>
    </div>
</div>

<div class="ad-slot" id="adContainer2" style="height: 100px; margin-top: 30px;">
    Another Advertisement Slot
</div>

<script>
window.addEventListener('load', function(){
  // --- AD RELOAD LOGIC (আপনার Original JS) ---
  function injectAdScript(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    container.innerHTML = ''; 

    const script1 = document.createElement('script');
    script1.type = 'text/javascript';
    script1.innerHTML = `
        var atOptions = {
            'key' : 'fa36be29858fbb2600610990328422a3',
            'format' : 'iframe',
            'height' : 60,
            'width' : 468,
            'params' : {}
        };
    `;
    container.appendChild(script1);
    
    const script2 = document.createElement('script');
    script2.type = 'text/javascript';
    script2.src = '//www.highperformanceformat.com/fa36be29858fbb2600610990328422a3/invoke.js';
    container.appendChild(script2);
  }

  function reloadAds() {
      injectAdScript('adContainer1');
      injectAdScript('adContainer2');
  }

  reloadAds(); 
  setInterval(reloadAds, 60000); 

  // এরর পেজের জন্য সার্চ বার Disable করা হয়েছে
  document.getElementById('searchInput').disabled = true;

});
</script>
</body>
</html>
