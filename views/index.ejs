<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LivetvApp - Home</title>

<script src="https://cdn.jsdelivr.net/npm/clappr@latest/dist/clappr.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  /* Material 3 Color Palette Simulation (Updated for Deep Blue Theme) */
  :root {
    --primary: #0D47A1;    /* Deep Blue - Primary Action */
    --accent: #00BCD4;     /* Bright Cyan - Secondary Accent */
    --bg-dark: #0A1929;    /* Very Dark Navy - Main Background */
    --bg-card: #1A2C40;    /* Dark Blue Surface - Card Background */
    --text: #E0F7FA;       /* Light Text */
    --outline: #546E7A;    /* Muted Blue-Grey - Outline/Subtext */
    --shadow-color: rgba(0, 0, 0, 0.6);
  }

  body { 
    margin: 0; 
    font-family: 'Roboto', sans-serif; 
    background: var(--bg-dark); 
    color: var(--text); 
    min-height: 100vh;
  }

  /* --- Top App Bar (Navbar) --- */
  nav {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 4%; 
    background: var(--bg-card); 
    position: sticky; top: 0; z-index: 50; /* Header z-index: 50 */
    box-shadow: 0 2px 4px var(--shadow-color); 
    min-height: 64px; 
  }
  .logo { font-size: 24px; font-weight: 700; color: var(--text); text-decoration: none;}
  .logo span { color: var(--primary); font-weight: 500;} 
  
  .nav-links {
    display: flex;
    align-items: center;
    margin-left: 50px; 
    flex-grow: 1; 
  }
  .nav-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
    padding: 10px 15px;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .nav-link:hover {
    /* Updated Primary Color RGBA */
    background: rgba(13, 71, 161, 0.2); 
  }

  .search-wrapper { position: relative; }
  .search-wrapper input {
    background: #000000; 
    border: none; 
    padding: 10px 40px 10px 15px;
    border-radius: 24px; 
    color: var(--text); 
    width: 250px; 
    transition: 0.3s;
    font-family: 'Roboto', sans-serif;
    box-shadow: inset 0 0 0 1px var(--outline); 
  }
  
  .search-wrapper input:focus { 
    border-color: transparent; 
    box-shadow: inset 0 0 0 2px var(--primary); 
  }

  .search-icon { position: absolute; right: 10px; top: 10px; color: var(--outline); }

  /* --- Ads --- */
  .ad-slot {
    width: 100%; max-width: 1000px; margin: 16px auto; min-height: 80px;
    background: var(--bg-dark); 
    border: 1px dashed var(--outline); 
    display: flex; 
    align-items: center; justify-content: center; color: var(--outline); 
    font-size: 14px;
    border-radius: 12px; 
  }

  /* --- Content Area --- */
  .container { padding: 16px 4%; max-width: 1600px; margin: auto; }
  
  .breadcrumb { 
    display: flex; align-items: center; justify-content: space-between; 
    margin-bottom: 20px; 
  }
  .section-title { 
    font-size: 28px; font-weight: 700; 
    padding-left: 0; 
    color: var(--text);
    margin-bottom: 30px;
  }
  
  /* --- Homepage Specific Styles --- */
  .hero-section {
    padding: 80px 0;
    text-align: center;
    /* Updated Gradient */
    background: linear-gradient(135deg, var(--bg-card) 0%, #0A1420 100%);
    border-radius: 16px;
    margin-bottom: 40px;
    box-shadow: 0 4px 15px var(--shadow-color);
  }
  .hero-section h1 {
    font-size: 48px;
    font-weight: 700;
    margin: 0 0 15px;
    color: var(--text);
  }
  .hero-section p {
    font-size: 18px;
    color: var(--outline);
    max-width: 600px;
    margin: 0 auto 30px;
  }
  .primary-btn {
    background: var(--primary);
    color: #fff;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 28px;
    font-weight: 500;
    transition: background 0.3s, transform 0.2s;
    display: inline-block;
  }
  .primary-btn:hover {
    /* New Hover Color */
    background: #0B3A87; 
    transform: translateY(-2px);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }
  .feature-card {
    background: var(--bg-card);
    padding: 25px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 2px 5px var(--shadow-color);
  }
  .feature-card i {
    font-size: 32px;
    color: var(--primary);
    margin-bottom: 15px;
  }
  .feature-card h4 {
    margin: 0 0 8px;
    font-weight: 500;
    color: var(--text);
  }
  .feature-card p {
    font-size: 14px;
    color: var(--outline);
  }

  /* Existing Styles for consistency (Hidden Player/Grid are unused here but included for full style block) */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .grid-full-span { grid-column: 1 / -1; }
  .card { background: var(--bg-card); border-radius: 16px; overflow: hidden; cursor: pointer; transition: all 0.2s ease; border: none; position: relative; box-shadow: 0 1px 3px var(--shadow-color); }
  .back-btn { display: none; }
  /* Player related styles are not needed here but kept in style block for consistency */

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .search-wrapper input { width: 120px; }
    .nav-links { display: none; } 
    .hero-section { padding: 40px 20px; }
    .hero-section h1 { font-size: 36px; }
    .section-title { font-size: 24px; }
    .feature-grid { gap: 15px; }
  }
</style>
</head>
<body>

<nav>
  <a href="/" class="logo">Livetv<span>App</span></a>
  <div class="nav-links">
    <a href="/" class="nav-link" style="background: rgba(13, 71, 161, 0.2);">Home</a> <a href="/streams" class="nav-link">Channels</a>
    <a href="/about" class="nav-link">About</a>
  </div>
  <div class="search-wrapper">
    <input type="text" id="searchInput" placeholder="Find channels...">
    <i class="fas fa-search search-icon"></i>
  </div>
</nav>

<div class="ad-slot" id="adContainer1">
  Advertisement Slot
</div>

<div class="container">
  
  <div class="hero-section">
    <h1>Watch Live Streams Anywhere.</h1>
    <p>LivetvApp brings you the best live TV experience with seamless streaming, no buffering, and a wide range of international channels.</p>
    <a href="/streams" class="primary-btn"><i class="fas fa-play"></i> Start Browsing Channels</a>
  </div>
  
  <h2 class="section-title" style="text-align: center;">Why Choose LivetvApp?</h2>

  <div class="feature-grid">
    <div class="feature-card">
      <i class="fas fa-broadcast-tower"></i>
      <h4>HD Quality Streaming</h4>
      <p>Enjoy crystal clear, high-definition video streams without lag.</p>
    </div>
    <div class="feature-card">
      <i class="fas fa-globe"></i>
      <h4>Global Channel Access</h4>
      <p>Access hundreds of channels from various categories and regions.</p>
    </div>
    <div class="feature-card">
      <i class="fas fa-mobile-alt"></i>
      <h4>Mobile Friendly</h4>
      <p>Watch on any device, anywhere. Optimized for mobile viewing.</p>
    </div>
  </div>

  <div class="ad-slot" id="adContainer2" style="height: 100px; margin-bottom: 30px; max-width: 100%;">
    Another Advertisement Slot
  </div>

</div>

<script>
window.addEventListener('load', function(){
  // --- AD RELOAD LOGIC (Simplified for non-player pages) ---
  function injectAdScript(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    
    container.innerHTML = '';
    
    const script1 = document.createElement('script');
    script1.type = 'text/javascript';
    script1.innerHTML = `
        var atOptions = {
            'key' : 'fa36be29858fbb2600610990328422a3',
            'format' : 'iframe',
            'height' : 60,
            'width' : 468,
            'params' : {}
        };
    `;
    container.appendChild(script1);
    
    const script2 = document.createElement('script');
    script2.type = 'text/javascript';
    script2.src = '//www.highperformanceformat.com/fa36be29858fbb2600610990328422a3/invoke.js';
    container.appendChild(script2);
  }

  function reloadAds() {
      injectAdScript('adContainer1');
      injectAdScript('adContainer2');
      console.log('Ad sections pre-loaded/reloaded successfully in the background.');
  }

  reloadAds(); 
  setInterval(reloadAds, 60000); 
  
  // Disable search bar functionality for the index page as it's primarily a landing page
  document.getElementById('searchInput').disabled = true;

});
</script>
</body>
</html>
